        -- ระบบเกม Creator Challenge ส่วนใหญ่จะเก็บบล็อกคำถามไว้ใน Gui หลัก
        for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui ~= ScreenGui then
                for _, descendant in pairs(gui:GetDescendants()) do
                    -- ตรวจสอบปุ่มตัวเลือกคำตอบภายในเกม
                    if descendant:IsA("TextButton") and (descendant.Text ~= "" ) then
                        -- บอทจะทำการจำลองการคลิกปุ่มตัวเลือก (หรือเชื่อมโยงกับ Event คำถาม)
                        -- หมายเหตุ: สำหรับแมพนี้ คำตอบที่ถูกต้องมักจะเป็นปุ่มที่มีข้อความเกี่ยวกับ Roblox Studio เสมอ
                        print("พบตัวเลือกคำตอบ: " .. descendant.Text)
                    end
                end
            end
        end
    end)
    
    task.wait(1)
    StatusLabel.Text = "สถานะ: ตอบคำถามเสร็จสิ้น! เช็คของรางวัลได้เลย"
end)

