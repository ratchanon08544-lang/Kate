-- ฟังก์ชันจำลองการคลิกปุ่มบนมือถือ/จอ
local function simulateClick(guiButton)
    if guiButton and guiButton:IsA("GuiButton") then
        -- ลองสั่งยิง Event คลิกของ Roblox โดยตรง
        for _, connection in pairs(getconnections(guiButton.MouseButton1Click)) do
            connection:Fire()
        end
        for _, connection in pairs(getconnections(guiButton.Activated)) do
            connection:Fire()
        end
    end
end

-- ระบบเปิด/ปิดการทำงานแบบลูปเช็คคำถาม
local running = false

ToggleButton.MouseButton1Click:Connect(function()
    running = not running
    if running then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        ToggleButton.Text = "🛑 กำลังทำงาน... (กดเพื่อหยุด)"
        StatusLabel.Text = "สถานะ: กำลังสแกนหาข้อสอบและปุ่มส่งคำตอบ..."
        
        task.spawn(function()
            while running do
                pcall(function()
                    -- วนหาปุ่มทั้งหมดใน PlayerGui (รวมถึงหน้าจอคำถามของแมพ)
                    for _, gui in pairs(PlayerGui:GetDescendants()) do
                        if gui:IsA("TextButton") and gui.Visible then
                            local text = string.lower(gui.Text)
                            
                            -- ตรวจสอบหาปุ่มตัวเลือก (ปกติแมพนี้มักจะเป็นตัวเลือกข้อ 1, 2, 3 หรือมีข้อความคำตอบ)
                            -- หรือปุ่มยืนยัน / ถัดไป / ส่งคำตอบ (Next, Submit, Continue, OK)
                            if text ~= "" and (
                                string.find(text, "next") or 
                                string.find(text, "submit") or 
                                string.find(text, "continue") or 
                                string.find(text, "ok") or
                                string.find(text, "ตอบ") or
                                string.find(text, "ถัดไป") or
                                string.find(text, "ยืนยัน")
                            ) then
                                simulateClick(gui)
                            end
                            
                            -- หากเจอตัวเลือกคำตอบข้อแรกๆ (สคริปต์จะกดเลือกตัวเลือกแรกหรือตัวเลือกที่มีเนื้อหา)
                            if gui.Parent and (string.find(string.lower(gui.Parent.Name), "answer") or string.find(string.lower(gui.Parent.Name), "option") or string.find(string.lower(gui.Name), "button")) then
                                simulateClick(gui)
                            end
                        end
                    end
                end)
                task.wait(0.5) -- เช็คทุกๆ ครึ่งวินาที
            end
        end)
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
        ToggleButton.Text = "⚡ เปิดระบบออโต้คลิกคำตอบ"
        StatusLabel.Text = "สถานะ: หยุดการทำงานแล้ว"
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    running = false
    ScreenGui:Destroy()
end)
